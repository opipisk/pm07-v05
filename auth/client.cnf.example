# Профиль клиента mariadb (пароль хранится здесь, вне скрипта).
# Скопируйте файл в auth/client.cnf, подставьте свой учебный пароль,
# затем выполните: chmod 600 auth/client.cnf
# Значения в этом примере — обозначения, а не рабочие секреты.
[client]
user=admin
password=<ADMIN_PASSWORD>
host=127.0.0.1
port=3306
