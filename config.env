# ПМ.07, вариант 05 (гостиница). Несекретные параметры запуска.
# Пароль в этот файл не записывается: он хранится в профиле auth/client.cnf.
# Файл читается заново при каждом запуске run.sh.

DB="pm07_v05"
CLIENT="mariadb"
DUMP="mariadb-dump"
AUTH="$WORK/auth/client.cnf"
AS_OF="2026-11-04"

# Параметры индивидуального дополнения (п. 5 списка дополнений):
# срок хранения архивов в сутках и уровень сжатия gzip.
RETENTION_DAYS="14"
GZIP_LEVEL="6"
